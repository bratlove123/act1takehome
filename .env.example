# Postgres connection string (local Docker Compose or Neon)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/act1

# Stand-in for a third-party pricing/FX API credential (server-side only)
EXTERNAL_API_KEY=replace-me-with-a-local-dev-key

# Optional — defaults to 4000
PORT=4000

# Set to "false" for local Postgres without SSL; omit/true for Neon
PGSSL=false
